# Copy to .env.local and fill in. Without these variables the app still runs:
# the site serves the default brand and stories come out of the fallback templates.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only: it bypasses RLS. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Story and illustration generation ──────────────────────────────────────
# Locally the key is needed; on Vercel the Gateway authenticates itself via OIDC.
# The same key covers text and illustrations. vercel.com → AI Gateway → API keys
AI_GATEWAY_API_KEY=
STORY_MODEL=anthropic/claude-sonnet-5
# Nano Banana: character coherence between pages. On the Gateway it is a
# language model that returns the image, not an "image model".
ILLUSTRATION_MODEL=google/gemini-2.5-flash-image

# ─── Mail (Resend) ──────────────────────────────────────────────────────────
# NOT needed for the backoffice access code: those emails are sent by Supabase,
# which has Resend wired up as SMTP (the key lives there, not here). This one is
# for the emails the app sends: eBook delivery, order confirmations.
# resend.com → API Keys
RESEND_API_KEY=
MAIL_FROM="Amabili Storie <ciao@amabilistorie.com>"

# ─── Site ───────────────────────────────────────────────────────────────────
# Used by `approveStory` to build the "Leggi la storia" link in the email.
# Without it, it falls back to http://localhost:3000 (wrong in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Payments (Stripe) ──────────────────────────────────────────────────────
# While this is EMPTY, every purchase is simulated: the order is created with
# `finto = true`, and the order → workflow → queue chain works without charging
# anyone (clean them up with `delete from ordini where finto`). Whether a
# merchant charges is decided by the `accetta_pagamenti` flag in the backoffice,
# not by this. As soon as the key is here, the real payment takes the place of
# the simulated one.
STRIPE_SECRET_KEY=
