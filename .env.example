# Copia in .env.local e riempi. Senza queste variabili l'app gira lo stesso:
# il sito serve il brand di default e le storie escono dai template di fallback.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo lato server: bypassa le RLS. Mai esporla al browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Generazione storie ─────────────────────────────────────────────────────
# In locale serve la chiave; su Vercel il Gateway si autentica da solo via OIDC.
# vercel.com → AI Gateway → API keys
AI_GATEWAY_API_KEY=
MODELLO_STORIE=anthropic/claude-sonnet-5

# ─── Mail (Resend) ──────────────────────────────────────────────────────────
# NON serve per il codice di accesso al backoffice: quelle mail le spedisce
# Supabase, a cui Resend è collegato come SMTP (la chiave sta là, non qui).
# Questa serve alle mail che manderà l'app: consegna dell'eBook, conferme
# d'ordine. resend.com → API Keys
RESEND_API_KEY=
MAIL_MITTENTE="Amabili Storie <ciao@amabilistorie.com>"

# ─── Sito ───────────────────────────────────────────────────────────────────
# Usata da `approvaStoria` per costruire il link "Leggi la storia" nella mail.
# Senza, ripiega su http://localhost:3000 (sbagliato in produzione).
NEXT_PUBLIC_SITO_URL=http://localhost:3000

# ─── Sviluppo ───────────────────────────────────────────────────────────────
# Checkout simulato: crea l'ordine e genera il libro senza far pagare nessuno.
# Gli ordini nati così hanno `finto = true`. In produzione questa flag NON esiste.
CHECKOUT_FINTO=1
