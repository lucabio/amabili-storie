# Copia in .env.local e riempi. Senza queste variabili l'app gira lo stesso:
# il sito serve il brand di default e le storie escono dai template di fallback.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo lato server: bypassa le RLS. Mai esporla al browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Generazione storie e illustrazioni ─────────────────────────────────────
# In locale serve la chiave; su Vercel il Gateway si autentica da solo via OIDC.
# La stessa chiave vale per il testo e per le illustrazioni. vercel.com → AI
# Gateway → API keys
AI_GATEWAY_API_KEY=
MODELLO_STORIE=anthropic/claude-sonnet-5
# Nano Banana: coerenza del personaggio fra le pagine. Sul Gateway è un
# language model che restituisce l'immagine, non un "image model".
MODELLO_ILLUSTRAZIONI=google/gemini-2.5-flash-image

# ─── Mail (Resend) ──────────────────────────────────────────────────────────
# NON serve per il codice di accesso al backoffice: quelle mail le spedisce
# Supabase, a cui Resend è collegato come SMTP (la chiave sta là, non qui).
# Questa serve alle mail che manderà l'app: consegna dell'eBook, conferme
# d'ordine. resend.com → API Keys
RESEND_API_KEY=
MAIL_MITTENTE="Amabili Storie <ciao@amabilistorie.com>"

# ─── Sito ───────────────────────────────────────────────────────────────────
# Usata da `approvaStoria` per costruire il link "Leggi la storia" nella mail.
# Senza, ripiega su http://localhost:3000 (sbagliato in produzione).
NEXT_PUBLIC_SITO_URL=http://localhost:3000

# ─── Pagamenti (Stripe) ─────────────────────────────────────────────────────
# Finché questa è VUOTA, ogni acquisto è simulato: l'ordine nasce con
# `finto = true`, la catena ordine → workflow → coda funziona senza far pagare
# nessuno (si cancellano con `delete from ordini where finto`). Se un merchant
# fa pagare lo decide il flag `accetta_pagamenti` dal backoffice, non questa.
# Appena c'è la chiave, il pagamento vero prende il posto del simulato.
STRIPE_SECRET_KEY=
